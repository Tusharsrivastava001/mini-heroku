generator client {
  provider = "prisma-client-js"
  previewFeatures = ["clientExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User of the platform
model User {
  id        String   @id @default(uuid())
  githubId  String   @unique
  username  String   @unique
  email     String   @unique
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  projects  Project[]
  auditLogs AuditLog[]
}

// Application project belonging to a user
model Project {
  id          String   @id @default(uuid())
  name        String
  repoUrl     String
  branch      String   @default("main")
  envVars     EnvVar[]
  deployments Deployment[]
  owner       User     @relation(fields: [ownerId], references: [id])
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Single deployment of a project
model Deployment {
  id        String   @id @default(uuid())
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String
  imageTag  String
  status    DeploymentStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum DeploymentStatus {
  PENDING
  BUILDING
  DEPLOYING
  LIVE
  FAILED
}

// Environment variables stored as K8s Secrets (also persisted for audit)
model EnvVar {
  id        String   @id @default(uuid())
  key       String
  value     String
  project   Project @relation(fields: [projectId], references: [id])
  projectId String
}

// Audit log for actions across the platform
model AuditLog {
  id        String   @id @default(uuid())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  action    String
  resource  String
  timestamp DateTime @default(now())
  details   Json?
}
