# DeployForge Terraform Input Variables Example
# Copy to terraform.tfvars and customize

aws_region        = "us-east-1"
environment       = "prod"
instance_type     = "t3.medium"
disk_size_gb      = 40
admin_cidr        = "0.0.0.0/0" # Restrict to your home/VPN IP for hardened security (e.g. 203.0.113.50/32)
ssh_public_key    = ""          # Optional: "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5..."
letsencrypt_email = "admin@yourdomain.com"
