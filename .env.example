# ==============================================================================
# DeployForge Environment Configuration (.env.example)
# Copy to .env and adjust values for your environment.
# ==============================================================================

# Core Platform Settings
NODE_ENV=development
BASE_DOMAIN=localtest.me
PORT=4000
API_PUBLIC_URL=http://localhost:4000
DASHBOARD_PUBLIC_URL=http://localhost:3000

# Security & Authentication
JWT_SECRET=deployforge_dev_jwt_secret_change_in_production_min32chars
SESSION_EXPIRES_IN=7d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef # 32 bytes hex for AES-256-GCM

# GitHub OAuth App (Leave dummy values for mock dev login)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_for_signature_verification

# Database (PostgreSQL)
DATABASE_URL=postgresql://deployforge:deployforge_secret@localhost:5432/deployforge?schema=public

# Cache & Queues (Redis)
REDIS_URL=redis://localhost:6379

# Container Registry
# For local dev: localhost:5001 or ttl.sh / docker daemon
REGISTRY_URL=localhost:5001
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
REGISTRY_INSECURE=true

# Kubernetes Configuration
# In-cluster automatically used when running in K8s. For local dev, specify kubeconfig path or default ~/.kube/config
KUBECONFIG_PATH=
K8S_DEFAULT_INGRESS_CLASS=traefik
K8S_CLUSTER_ISSUER=letsencrypt-prod

# Observability
LOKI_URL=http://localhost:3100
PROMETHEUS_URL=http://localhost:9090
